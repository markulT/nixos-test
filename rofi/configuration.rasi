configuration {
  modi: "drun,run";
  show-icons: true;
  font: "JetBrainsMono Nerd Font 12";
}

@theme "/dev/null"

* {
  bg: #2E3440;
  fg: #D8DEE9;
  accent: #88C0D0;
  background-color: @bg;
  text-color: @fg;
}

window {
  window : 50%;
  border-radius: 8px;
  border: 2px solid @accent;
}

listview {
  padding: 10px;
  lines: 8;
}

element {
  padding: 5px;
  border-radius: 4px;
}

element-text {
  vertical-align: 0.5;
}

element-icon {
  size: 24px;
  padding: 0 10px 0 0;
}

element selected {
  background-color: @accent;
  text-color: @bg;
}

inputbar {
  padding: 10px;
  children: [prompt, entry];
}

prompt {
  padding:0 10px 0 0;
}
